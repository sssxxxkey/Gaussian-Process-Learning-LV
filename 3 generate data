    0,
    NoisePer*np.mean(abs(y_pool)),
    len(y_pool)
)


x_noise=x_pool+noise_x
y_noise=y_pool+noise_y



# random sampling

Num_data=200

idx=np.sort(
    np.random.choice(
        len(x_pool),
        Num_data,
        replace=False
    )
)


